# Sanity CMS — fill in real values in .env.local (never commit .env.local)
SANITY_PROJECT_ID=
SANITY_ORG_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-03-01
SANITY_STUDIO_ENABLED=false

# Vimeo — personal access token for NO SCHOOL video playback via SimplePlayer
# (needs access to play.progressive / play.hls on the noschool videos)
VIMEO_ACCESS_TOKEN=

# Shopify Storefront API — from the store's Headless channel (Hydrogen/Headless app).
# Public Storefront token only; never put an Admin API token in this app.
# Domain without protocol, e.g. your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
# "Public access token" shown under the Headless channel's Storefront API section
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=
# Storefront API version; defaults to 2025-01 when unset
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2025-01
