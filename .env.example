# Sanity CMS — fill in real values in .env.local (never commit .env.local)
SANITY_PROJECT_ID=
SANITY_ORG_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2026-03-01
SANITY_STUDIO_ENABLED=false

# Vimeo — personal access token for NO SCHOOL video playback via SimplePlayer
# (needs access to play.progressive / play.hls on the noschool videos)
VIMEO_ACCESS_TOKEN=

# Shopify Storefront API — Sales channels → Headless → your storefront.
# Public Storefront token only; never put an Admin API token (shpat_…) in this app.
# Domain without protocol, e.g. your-store.myshopify.com — not a hex string.
# Server-only names are preferred so Next does not inline an empty value at build.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_TOKEN=
# Optional Headless private token (server-only). Same shop, Shopify-Storefront-Private-Token header.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Storefront API version; defaults to 2025-01 when unset
SHOPIFY_STOREFRONT_API_VERSION=2025-01
# Aliases also accepted: NEXT_PUBLIC_SHOPIFY_* and Hydrogen PUBLIC_STORE_* / PUBLIC_STOREFRONT_*
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2025-01
